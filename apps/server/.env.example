# Продуктовое подключение (роль orbis_app, RLS enforced). Локально:
DATABASE_URL=postgres://orbis_app:orbis_app_local@127.0.0.1:54322/postgres
# Админ (миграции, setup-db, сид реестра). НЕ используется продуктовым кодом:
DATABASE_URL_ADMIN=postgres://postgres:postgres@127.0.0.1:54322/postgres
ORBIS_APP_PASSWORD=orbis_app_local
# prepare=false обязателен только для transaction-пулера :6543 (hosted)
# PG_PREPARE=false

# Supabase API (для T7+)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key

# Верификация JWT (jose): JWKS = {SUPABASE_URL}/auth/v1/.well-known/jwks.json,
# fallback HS256 по legacy-секрету (локально — JWT_SECRET из `bunx supabase status`)
SUPABASE_JWT_SECRET=your-jwt-secret
# SUPABASE_JWKS_URL=  # опциональный override URL JWKS

# Публичный адрес сервиса — база абсолютных URL в метаданных OAuth (§9.3): по ним
# MCP-клиент находит вход. ЛОКАЛЬНО НЕ НУЖНА: без неё база берётся из адреса запроса,
# и это безопасно — на стенде нет ни владельца, ни данных. В production, наоборот,
# обязательна, и без неё сервис НЕ ПОДНИМЕТСЯ (отказ при старте, а не 500 на запросе):
# иначе базу пришлось бы доверять заголовку Host, а подменённый Host увёл бы клиента
# на чужой authorization server прямо через наши метаданные. Значение — только чистый
# origin, без пути/query/фрагмента; кривое значение роняет старт в любом окружении.
# ORBIS_PUBLIC_URL=https://orbis-64q4.onrender.com

# Доступ внешних агентов (§9.3, MCP) переменных окружения БОЛЬШЕ НЕ ТРЕБУЕТ. Решение D34:
# и браузерный вход (OAuth 2.1), и headless-токен живут строкой в таблице agent_grants —
# в базе только sha256, сырой токен показывается один раз. Прежних ORBIS_PAT_HASH и
# ORBIS_PAT_OWNER_ID здесь нет намеренно: их не читает ни одна строка кода.
#   выпуск headless-токена локально:  bun scripts/issue-pat.ts <owner-uuid> [метка]
#   отзыв (любого доступа):           «Настройки → Агенты» в приложении

# --- LLM-провайдер (PRD 01 §7.7) -------------------------------------------
# В проде выбор провайдера ЯВНЫЙ (render.yaml = openai), а здесь строка закомментирована
# нарочно: копия этого файла обязана поднимать dev-сервер без единого секрета. Пока
# переменной нет, действует умолчание — один ключ → этот провайдер, ОБА ключа → отказ
# при старте (неоднозначность разрешает человек), ключей нет → echo в dev и отказ
# в production. Раскомментируйте, когда ключ выбранного провайдера уже лежит ниже:
# с явным выбором и без ключа старт падает намеренно.
# См. apps/server/src/llm/provider.ts.
# ORBIS_LLM_PROVIDER=openai
# Нужен, если ORBIS_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Нужен, если ORBIS_LLM_PROVIDER=openai
OPENAI_API_KEY=
# (опц.) модель. Без неё — дефолт выбранного провайдера: claude-sonnet-5 либо gpt-5.5.
# ORBIS_LLM_MODEL=
