+async function admissionStep<T>(label: string, action: () => Promise<T>, ms = 8_000): Promise<T> {
+  log('admission-step-start', { label });
+  try {
+    const value = await within(action(), label, ms);
+    log('admission-step-complete', { label });
+    return value;
+  } catch (error) {
